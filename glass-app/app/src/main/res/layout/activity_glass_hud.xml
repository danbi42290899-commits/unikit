<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hud_background"
    android:padding="16dp">

    <!-- ============ TOP-LEFT: vitals ============ -->
    <LinearLayout
        android:id="@+id/vitalsBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textBp"
            style="@style/HudVitalText"
            android:text="BP --/--"
            tools:text="BP 118/76" />

        <TextView
            android:id="@+id/textSpo2"
            style="@style/HudVitalText"
            android:text="SpO2 --%"
            tools:text="SpO2 98%" />

        <TextView
            android:id="@+id/textHr"
            style="@style/HudVitalText"
            android:text="HR --"
            tools:text="HR 72" />

        <TextView
            android:id="@+id/textTemp"
            style="@style/HudVitalText"
            android:text="TEMP -- C"
            tools:text="TEMP 36.7 C" />
    </LinearLayout>

    <!-- ============ TOP-RIGHT: patient + connection ============ -->
    <LinearLayout
        android:id="@+id/patientBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textPatient"
            style="@style/HudVitalText"
            android:text="NO PATIENT"
            tools:text="KJH / F32" />

        <TextView
            android:id="@+id/textConnection"
            style="@style/HudStatusText"
            android:textColor="@color/hud_connecting"
            android:text="CONNECTING"
            tools:text="● CONNECTED" />

        <TextView
            android:id="@+id/textSimBadge"
            style="@style/HudBadgeText"
            android:text="SIM"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- ============ CENTER: camera / endoscope view ============ -->
    <!-- imageCamera renders whatever /ws/camera relays: phone camera today,
         a real endoscope feed later, same relay and same view. Placeholder
         text stays visible until the first frame arrives. -->
    <FrameLayout
        android:id="@+id/endoscopeArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/vitalsBlock"
        app:layout_constraintBottom_toTopOf="@id/examModeBlock"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imageCamera"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:visibility="gone"
            android:contentDescription="@string/camera_view_description"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textEndoscopePlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="ENDOSCOPE VIEW"
            android:textColor="@color/hud_text_muted"
            android:textSize="16sp"
            android:letterSpacing="0.1" />
    </FrameLayout>

    <!-- ============ BOTTOM-LEFT: exam mode ============ -->
    <LinearLayout
        android:id="@+id/examModeBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/textExamMode"
            style="@style/HudStatusText"
            android:text="NONE"
            tools:text="OTOSCOPE-L" />
    </LinearLayout>

    <!-- ============ BOTTOM-RIGHT: recording ============ -->
    <LinearLayout
        android:id="@+id/recordingBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/textRecording"
            style="@style/HudStatusText"
            android:text=""
            tools:text="● REC 01:24" />
    </LinearLayout>

    <!-- ============ Transient banner: DISCONNECTED / RECONNECTED / CAPTURE SAVED ============ -->
    <TextView
        android:id="@+id/textBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/hud_banner_bg"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:textColor="@color/hud_text_primary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="DISCONNECTED"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
